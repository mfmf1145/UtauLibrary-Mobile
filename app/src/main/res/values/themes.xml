<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      仅作为 Activity 窗口底色，真正的视觉全部由 Compose 中的 OuTheme 提供。
      底色取自 OpenUtau 的 BackgroundColor，避免启动瞬间出现 Material 默认白/紫。
    -->
    <style name="Theme.UtauMarket" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ou_window_background</item>
        <item name="android:colorBackground">@color/ou_window_background</item>
        <item name="android:statusBarColor">@color/ou_window_background</item>
        <item name="android:navigationBarColor">@color/ou_window_background</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="colorAccent">#4EA6EA</item>
    </style>

    <style name="Theme.UtauMarket.Splash" parent="Theme.UtauMarket">
        <item name="android:windowBackground">@color/ou_window_background</item>
    </style>
</resources>
